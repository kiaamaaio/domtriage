{
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "Bash(git * push *)",
      "Bash(go get *)",
      "Edit(/.claude/**)",
      "Edit(/.githooks/**)",
      "Edit(/scripts/claude-commit-check)",
      "Edit(/scripts/allowed-modules)",
      "Edit(/CLAUDE.md)",
      "Edit(/PLAN.md)",
      "Edit(/go.mod)",
      "Edit(/tools/eval/phase0/randomcheck.py)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git * push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git * push -f*)",
      "Bash(git * push * -f*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git * commit *--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n *)",
      "Bash(git * commit -n*)",
      "Bash(git * commit * -n *)",
      "Bash(git *core.hooksPath=*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/claude-commit-check",
            "timeout": 600,
            "onFailure": "block",
            "statusMessage": "コミット前の確認を実行中..."
          }
        ]
      }
    ]
  }
}
